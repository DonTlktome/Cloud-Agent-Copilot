# Copy to .env and fill in. .env is git-ignored: never commit real credentials.

# Which Agent CLI runs the tasks: codex | claude | mock
#   codex  - OpenAI Codex CLI, talks to the platform's OpenAI Responses API directly (recommended)
#   claude - Claude Code, through the LiteLLM sidecar (docker compose --profile proxy up)
#   mock   - built-in fake agent, no key needed (UI demo / tests)
AGENT_CLI=codex

# Model endpoint provided by the exam platform (OpenAI-compatible, ends with /v1)
MODEL_BASE_URL=https://showmevibecode.up.railway.app/api/model/v1
MODEL_API_KEY=replace-me
AGENT_MODEL=linext-5.3-luna

# Only for AGENT_CLI=claude (LiteLLM proxy). Any random string; the agent only ever sees this local key.
LITELLM_MASTER_KEY=sk-local-workbench-change-me
LITELLM_UPSTREAM_MODEL=openai/linext-5.3-luna

# Limits
RUN_TIMEOUT_SEC=1200
MAX_CONCURRENT_RUNS=3
MAX_TURNS=80
MAX_UPLOAD_MB=50
# HOST_PORT=8080
